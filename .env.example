# Alibaba DashScope (通义千问云端) — required when generation model is "qwen"
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# Optional: override defaults
# DASHSCOPE_VL_MODEL=qwen-vl-plus
# DASHSCOPE_VL_MODEL=qwen-vl-max
# China (default): https://dashscope.aliyuncs.com/compatible-mode/v1
# International:   https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Set to 1 only if DashScope must go through HTTP_PROXY / Clash
# DASHSCOPE_USE_PROXY=0

# Local ColPali weights (sibling folder by default: ../models)
# LOCAL_MODELS_DIR=D:\AI02-就业\B-大模型项目\2-rag项目\vlm-rag项目\models
# LOCAL_COLPALI_PATH=D:\AI02-就业\B-大模型项目\2-rag项目\vlm-rag项目\models\vidore-colpali-v1.2

# Other cloud providers (optional)
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
